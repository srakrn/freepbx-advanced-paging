<module>
    <rawname>advancedpaging</rawname>
    <name>Advanced Paging</name>
    <version>17.0.0</version>
    <publisher>Advanced Paging contributors</publisher>
    <license>GPLv3+</license>
    <category>Applications</category>
    <description>Configurable paging groups with lifecycle announcements and simplex or duplex audio.</description>
    <changelog>
        *17.0.0* First stable release of Advanced Paging for FreePBX 17.
        *17.0.0alpha6* Add the global Drop Silence option for paging conferences.
        *17.0.0alpha5* Preserve the initiating caller ID on receiver origination.
        *17.0.0alpha4* Add caller-only instruction playback, speaker volume override, and Skip/Force/Whisper busy policies.
        *17.0.0alpha3* Add the BMO config-page initialization hook; reconcile shutdown using a fresh AMI connection.
        *17.0.0alpha2* Reduce setup delay after first receiver answers; resolve registered PJSIP contacts and Paging auto-answer overrides.
        *17.0.0alpha1* Initial development preview.
    </changelog>
    <depends>
        <version>17.0.1</version>
        <module>core ge 17.0.1</module>
        <module>recordings ge 17.0.1</module>
        <module>paging ge 17.0.1</module>
    </depends>
    <methods>
        <get_config pri="600">advancedpaging_get_config</get_config>
    </methods>
    <fileinclude>
        <install>preinstall.php</install>
    </fileinclude>
    <menuitems>
        <advancedpaging needsenginedb="yes">Advanced Paging</advancedpaging>
    </menuitems>
    <database>
        <table name="advancedpaging_groups">
            <field name="id" type="integer" primarykey="true" autoincrement="true"/>
            <field name="name" type="string" length="255"/>
            <field name="extension" type="string" length="25"/>
            <field name="enabled" type="boolean" default="1"/>
            <field name="audio_mode" type="string" length="10"/>
            <field name="pre_recording_id" type="integer" notnull="false"/>
            <field name="post_recording_id" type="integer" notnull="false"/>
            <field name="instruction_recording_id" type="integer" notnull="false"/>
            <field name="speaker_volume" type="integer" default="0"/>
            <field name="busy_policy" type="integer" default="0"/>
            <key name="advancedpaging_groups_extension_uq" type="unique">
                <column name="extension"/>
            </key>
        </table>
        <table name="advancedpaging_members">
            <field name="group_id" type="integer" primarykey="true"/>
            <field name="extension" type="string" length="25" primarykey="true"/>
        </table>
        <table name="advancedpaging_settings">
            <field name="setting_key" type="string" length="64" primarykey="true"/>
            <field name="setting_value" type="string" length="255"/>
        </table>
    </database>
    <supported>
        <version>17.0</version>
    </supported>
</module>
